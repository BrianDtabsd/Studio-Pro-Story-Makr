{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "avatarSeed": { "type": "string" },
        "joinedDate": { "type": "number" },
        "isPro": { "type": "boolean" }
      },
      "required": ["username", "avatarSeed", "joinedDate"]
    },
    "Project": {
      "title": "Project",
      "description": "A story project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "lastModified": { "type": "number" },
        "progress": { "type": "number" },
        "thumbnailUrl": { "type": "string" },
        "state": { "type": "object" }
      },
      "required": ["id", "title", "lastModified", "progress", "state"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    }
  }
}
