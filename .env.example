# Story Makr runtime configuration (copy to .env.local)

# Required for direct Gemini SDK usage and any local tooling paths that reference it.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional but recommended for embedded Stripe checkout flow.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_key_here

# Story Makr AI mode:
# - strict: only Cloud Functions endpoints
# - fallback: reserved mode for future fallback logic
# - off: disable AI callables
STORYMAKR_AI_MODE=strict

# Optional callable overrides (defaults shown).
# STORYMAKR_AI_GENERATE_STORY_IDEAS_CALLABLE=generateStoryIdeas
# STORYMAKR_AI_GENERATE_SCRIPT_CALLABLE=generateScript
# STORYMAKR_AI_ANALYZE_SCRIPT_CALLABLE=analyzeScript
# STORYMAKR_AI_ANALYZE_CHARACTER_AVATAR_CALLABLE=analyzeCharacterAvatar
# STORYMAKR_AI_GENERATE_SPEECH_CALLABLE=generateSpeech
# STORYMAKR_AI_GENERATE_IMAGE_CALLABLE=generateImage
# STORYMAKR_AI_GENERATE_VIDEO_CALLABLE=generateVideo

# Optional Stripe callable override (default: createCheckoutSession)
# STORYMAKR_STRIPE_CHECKOUT_CALLABLE=createCheckoutSession
